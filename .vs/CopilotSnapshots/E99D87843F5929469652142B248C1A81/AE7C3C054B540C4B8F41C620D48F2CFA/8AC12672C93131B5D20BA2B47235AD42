namespace Trabajo_Janier
{
    public partial class Form1 : Form
    {
        private readonly Panel sidebar;
        private readonly Panel areaContenido;
        private readonly List<Button> botonesMenu = new();
        private readonly Dictionary<string, Form> formularios = new();
        private Button botonActivo;

        private readonly Color colorFondo = Color.FromArgb(245, 247, 242);
        private readonly Color colorSidebar = Color.FromArgb(255, 255, 255);
        private readonly Color colorVerdePrincipal = Color.FromArgb(44, 149, 73);
        private readonly Color colorVerdeClaro = Color.FromArgb(214, 239, 220);
        private readonly Color colorTextoOscuro = Color.FromArgb(33, 43, 36);
        private readonly Color colorTextoSecundario = Color.FromArgb(94, 106, 98);
        private readonly Color colorSeparador = Color.FromArgb(226, 232, 228);

        public Form1()
        {
            InitializeComponent();

            this.Text = "Agrosoft SENA";
            this.StartPosition = FormStartPosition.CenterScreen;
            this.WindowState = FormWindowState.Maximized;
            this.BackColor = colorFondo;
            this.DoubleBuffered = true;
            this.MinimumSize = new Size(1024, 700);
            this.FormBorderStyle = FormBorderStyle.Sizable;
            this.Resize += Form1_Resize;

            sidebar = CrearSidebar();
            areaContenido = CrearAreaContenido();

            this.Controls.Add(sidebar);
            this.Controls.Add(areaContenido);

            var dashboard = CrearVista("Dashboard", "Resumen general del sistema");
            var sensores = CrearVista("Sensores", "Monitoreo y estado de sensores");
            var conexiones = CrearVista("Conexiones", "Conexiones activas y estados");
            var perfil = CrearVista("Perfil", "Información de perfil y cuenta");

            formularios.Add("Dashboard", dashboard);
            formularios.Add("Sensores", sensores);
            formularios.Add("Conexiones", conexiones);
            formularios.Add("Perfil", perfil);

            AbrirFormulario(dashboard);
            SeleccionarBoton(botonesMenu[0]);
            AjustarAreaContenido();
        }

        private Panel CrearSidebar()
        {
            var panelSidebar = new Panel
            {
                Dock = DockStyle.Left,
                Width = 240,
                BackColor = colorSidebar,
                Padding = new Padding(0),
                BorderStyle = BorderStyle.None
            };

            var brand = new Panel
            {
                Dock = DockStyle.Top,
                Height = 96,
                BackColor = colorSidebar,
                Padding = new Padding(18, 18, 18, 18)
            };

            var logo = new Label
            {
                Width = 42,
                Height = 42,
                Text = "A",
                TextAlign = ContentAlignment.MiddleCenter,
                Dock = DockStyle.Left,
                Font = new Font("Segoe UI", 18F, FontStyle.Bold),
                ForeColor = Color.White,
                BackColor = colorVerdePrincipal,
                Margin = new Padding(0, 0, 12, 0),
                BorderStyle = BorderStyle.None
            };

            var titulo = new Label
            {
                Dock = DockStyle.Fill,
                Text = "Agrosoft SENA",
                ForeColor = colorTextoOscuro,
                Font = new Font("Segoe UI", 15F, FontStyle.Bold),
                TextAlign = ContentAlignment.MiddleLeft,
                AutoSize = false,
                MaximumSize = new Size(200, 0)
            };

            brand.Controls.Add(titulo);
            brand.Controls.Add(logo);
            brand.Controls.SetChildIndex(logo, 0);
            brand.Controls.SetChildIndex(titulo, 1);

            var menuContainer = new FlowLayoutPanel
            {
                Dock = DockStyle.Top,
                AutoSize = false,
                Height = 240,
                FlowDirection = FlowDirection.TopDown,
                WrapContents = false,
                BackColor = colorSidebar,
                Padding = new Padding(12, 16, 12, 0)
            };

            string[] opciones = { "Dashboard", "Sensores", "Conexiones", "Perfil" };

            foreach (var opcion in opciones)
            {
                var boton = new Button
                {
                    Name = opcion,
                    Text = opcion,
                    Height = 46,
                    Width = 216,
                    FlatStyle = FlatStyle.Flat,
                    Font = new Font("Segoe UI", 11F, FontStyle.Bold),
                    ForeColor = colorTextoOscuro,
                    BackColor = Color.Transparent,
                    TextAlign = ContentAlignment.MiddleLeft,
                    Padding = new Padding(18, 0, 0, 0),
                    Margin = new Padding(0, 0, 0, 10),
                    Cursor = Cursors.Hand,
                    Anchor = AnchorStyles.Left | AnchorStyles.Right
                };

                boton.FlatAppearance.BorderSize = 0;
                boton.MouseEnter += (_, _) =>
                {
                    if (boton != botonActivo)
                    {
                        boton.BackColor = colorVerdeClaro;
                    }
                };
                boton.MouseLeave += (_, _) =>
                {
                    if (boton != botonActivo)
                    {
                        boton.BackColor = Color.Transparent;
                    }
                };
                boton.Click += (_, _) =>
                {
                    if (formularios.TryGetValue(opcion, out var formHijo))
                    {
                        AbrirFormulario(formHijo);
                    }

                    SeleccionarBoton(boton);
                };

                botonesMenu.Add(boton);
                menuContainer.Controls.Add(boton);
            }

            var separador = new Panel
            {
                Dock = DockStyle.Top,
                Height = 1,
                Margin = new Padding(16, 14, 16, 8),
                BackColor = colorSeparador
            };

            var botonCerrar = new Button
            {
                Dock = DockStyle.Bottom,
                Height = 52,
                Text = "Cerrar sesión",
                FlatStyle = FlatStyle.Flat,
                Font = new Font("Segoe UI", 11F, FontStyle.Bold),
                ForeColor = Color.FromArgb(201, 62, 62),
                BackColor = Color.Transparent,
                TextAlign = ContentAlignment.MiddleCenter,
                Margin = new Padding(12, 0, 12, 18),
                Cursor = Cursors.Hand
            };
            botonCerrar.FlatAppearance.BorderSize = 0;
            botonCerrar.Click += (_, _) => Application.Exit();

            panelSidebar.Controls.Add(botonCerrar);
            panelSidebar.Controls.Add(separador);
            panelSidebar.Controls.Add(menuContainer);
            panelSidebar.Controls.Add(brand);

            return panelSidebar;
        }

        private Panel CrearAreaContenido()
        {
            var panel = new Panel
            {
                Location = new Point(240, 0),
                Size = new Size(Math.Max(this.ClientSize.Width - 240, 0), this.ClientSize.Height),
                Anchor = AnchorStyles.Top | AnchorStyles.Bottom | AnchorStyles.Left | AnchorStyles.Right,
                BackColor = colorFondo,
                BorderStyle = BorderStyle.None
            };

            return panel;
        }

        private Form CrearVista(string titulo, string descripcion)
        {
            var form = new Form
            {
                Text = titulo,
                BackColor = colorFondo,
                FormBorderStyle = FormBorderStyle.None,
                StartPosition = FormStartPosition.Manual,
                TopLevel = false,
                Padding = new Padding(26),
                Dock = DockStyle.Fill,
                Visible = false
            };

            var contenido = new Panel
            {
                Dock = DockStyle.Fill,
                BackColor = Color.FromArgb(255, 255, 255),
                Padding = new Padding(24),
                BorderStyle = BorderStyle.None
            };

            var encabezado = new Label
            {
                Dock = DockStyle.Top,
                Height = 56,
                Text = titulo,
                ForeColor = colorTextoOscuro,
                Font = new Font("Segoe UI", 20F, FontStyle.Bold),
                TextAlign = ContentAlignment.MiddleLeft,
                Padding = new Padding(0),
                Margin = new Padding(0, 0, 0, 18)
            };

            var subtitulo = new Label
            {
                Dock = DockStyle.Top,
                Text = descripcion,
                ForeColor = colorTextoSecundario,
                Font = new Font("Segoe UI", 11F, FontStyle.Regular),
                Height = 24,
                Margin = new Padding(0, 0, 0, 18)
            };

            var tarjeta = new Panel
            {
                Dock = DockStyle.Top,
                Height = 170,
                BackColor = colorVerdeClaro,
                Padding = new Padding(18),
                Margin = new Padding(0, 0, 0, 0)
            };

            var tituloTarjeta = new Label
            {
                Dock = DockStyle.Top,
                Text = titulo,
                ForeColor = colorTextoOscuro,
                Font = new Font("Segoe UI", 16F, FontStyle.Bold),
                Height = 30
            };

            var textoTarjeta = new Label
            {
                Dock = DockStyle.Fill,
                Text = "Bienvenido a la vista de " + titulo + ". Aquí se mostrará la información principal relacionada con esta sección.",
                ForeColor = colorTextoOscuro,
                Font = new Font("Segoe UI", 11F, FontStyle.Regular),
                AutoSize = false,
                Padding = new Padding(0, 8, 0, 0)
            };

            tarjeta.Controls.Add(textoTarjeta);
            tarjeta.Controls.Add(tituloTarjeta);
            tarjeta.Controls.SetChildIndex(tituloTarjeta, 0);
            tarjeta.Controls.SetChildIndex(textoTarjeta, 1);

            contenido.Controls.Add(tarjeta);
            contenido.Controls.Add(subtitulo);
            contenido.Controls.Add(encabezado);
            form.Controls.Add(contenido);

            return form;
        }

        private void SeleccionarBoton(Button boton)
        {
            foreach (var item in botonesMenu)
            {
                if (item == boton)
                {
                    item.BackColor = colorVerdeClaro;
                    item.ForeColor = colorTextoOscuro;
                    item.FlatAppearance.BorderSize = 0;
                }
                else
                {
                    item.BackColor = Color.Transparent;
                    item.ForeColor = colorTextoOscuro;
                }
            }

            botonActivo = boton;
        }

        public void AbrirFormulario(Form formHijo)
        {
            if (formHijo == null)
            {
                return;
            }

            areaContenido.Controls.Clear();

            formHijo.TopLevel = false;
            formHijo.FormBorderStyle = FormBorderStyle.None;
            formHijo.Dock = DockStyle.Fill;
            formHijo.Show();
            areaContenido.Controls.Add(formHijo);
            areaContenido.BringToFront();
        }

        private void Form1_Resize(object? sender, EventArgs e)
        {
            AjustarAreaContenido();
        }

        private void AjustarAreaContenido()
        {
            if (areaContenido == null)
            {
                return;
            }

            areaContenido.Location = new Point(240, 0);
            areaContenido.Size = new Size(Math.Max(this.ClientSize.Width - 240, 0), this.ClientSize.Height);
        }
    }
}
