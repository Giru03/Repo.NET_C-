namespace Trabajo_Janier
{
    public class LoginForm : Form
    {
        private readonly TextBox txtUsuario;
        private readonly TextBox txtPassword;
        private readonly Label lblError;

        public LoginForm()
        {
            Text = "Agrosoft SENA - Login";
            Size = new Size(400, 500);
            StartPosition = FormStartPosition.CenterScreen;
            FormBorderStyle = FormBorderStyle.FixedDialog;
            MaximizeBox = false;
            MinimizeBox = false;
            ShowIcon = false;
            BackColor = Tema.FondoGeneral;
            DoubleBuffered = true;

            var pnlContenido = new Panel
            {
                Dock = DockStyle.Fill,
                BackColor = Tema.FondoGeneral,
                Padding = new Padding(30, 25, 30, 20)
            };

            var logo = new Label
            {
                Text = "Agrosoft SENA",
                Font = new Font("Segoe UI", 20F, FontStyle.Bold),
                ForeColor = Tema.VerdePrincipal,
                AutoSize = true,
                Location = new Point(0, 0)
            };

            var lblSubtitulo = new Label
            {
                Text = "Sistema de gestión agrícola",
                Font = new Font("Segoe UI", 10F, FontStyle.Regular),
                ForeColor = Color.FromArgb(86, 99, 92),
                AutoSize = true,
                Location = new Point(0, 42)
            };

            txtUsuario = new TextBox
            {
                Text = "Usuario",
                ForeColor = Color.Gray,
                Font = new Font("Segoe UI", 11F),
                Width = 300,
                Height = 38,
                Location = new Point(0, 110),
                BorderStyle = BorderStyle.FixedSingle
            };
            txtUsuario.Enter += (_, _) =>
            {
                if (txtUsuario.Text == "Usuario")
                {
                    txtUsuario.Text = string.Empty;
                    txtUsuario.ForeColor = Tema.TextoOscuro;
                }
            };
            txtUsuario.Leave += (_, _) =>
            {
                if (string.IsNullOrWhiteSpace(txtUsuario.Text))
                {
                    txtUsuario.Text = "Usuario";
                    txtUsuario.ForeColor = Color.Gray;
                }
            };

            txtPassword = new TextBox
            {
                Text = "Contraseña",
                ForeColor = Color.Gray,
                Font = new Font("Segoe UI", 11F),
                Width = 300,
                Height = 38,
                Location = new Point(0, 170),
                BorderStyle = BorderStyle.FixedSingle,
                PasswordChar = '*'
            };
            txtPassword.Enter += (_, _) =>
            {
                if (txtPassword.Text == "Contraseña")
                {
                    txtPassword.Text = string.Empty;
                    txtPassword.ForeColor = Tema.TextoOscuro;
                    txtPassword.PasswordChar = '*';
                }
            };
            txtPassword.Leave += (_, _) =>
            {
                if (string.IsNullOrWhiteSpace(txtPassword.Text))
                {
                    txtPassword.Text = "Contraseña";
                    txtPassword.ForeColor = Color.Gray;
                    txtPassword.PasswordChar = '\0';
                }
            };

            lblError = new Label
            {
                Text = "Usuario o contraseña incorrectos",
                ForeColor = Tema.Rojo,
                Font = new Font("Segoe UI", 10F, FontStyle.Regular),
                AutoSize = true,
                Visible = false,
                Location = new Point(0, 232)
            };

            var btnIngresar = new Button
            {
                Text = "Iniciar sesión",
                Width = 300,
                Height = 42,
                Location = new Point(0, 270),
                FlatStyle = FlatStyle.Flat,
                BackColor = Tema.VerdePrincipal,
                ForeColor = Color.White,
                Font = new Font("Segoe UI", 11F, FontStyle.Bold),
                Cursor = Cursors.Hand
            };
            btnIngresar.FlatAppearance.BorderSize = 0;
            btnIngresar.Click += BtnIngresar_Click;

            txtPassword.KeyDown += (_, e) =>
            {
                if (e.KeyCode == Keys.Enter)
                {
                    BtnIngresar_Click(this, EventArgs.Empty);
                    e.Handled = true;
                    e.SuppressKeyPress = true;
                }
            };

            txtUsuario.KeyDown += (_, e) =>
            {
                if (e.KeyCode == Keys.Enter)
                {
                    txtPassword.Focus();
                    e.Handled = true;
                    e.SuppressKeyPress = true;
                }
            };

            pnlContenido.Controls.Add(logo);
            pnlContenido.Controls.Add(lblSubtitulo);
            pnlContenido.Controls.Add(txtUsuario);
            pnlContenido.Controls.Add(txtPassword);
            pnlContenido.Controls.Add(lblError);
            pnlContenido.Controls.Add(btnIngresar);

            Controls.Add(pnlContenido);
        }

        private void BtnIngresar_Click(object sender, EventArgs e)
        {
            const string usuarioCorrecto = "admin";
            const string passwordCorrecto = "admin123";

            string usuario = txtUsuario.Text.Trim();
            string password = txtPassword.Text.Trim();

            if (usuario == usuarioCorrecto && password == passwordCorrecto)
            {
                var formPrincipal = new Form1();
                formPrincipal.Show();
                Hide();
            }
            else
            {
                lblError.Visible = true;
                lblError.Text = "Usuario o contraseña incorrectos";
                txtPassword.Text = string.Empty;
                txtPassword.ForeColor = Tema.TextoOscuro;
                txtPassword.PasswordChar = '*';
                txtPassword.Focus();
            }
        }
    }
}
