namespace Trabajo_Janier
{
    public partial class Form1 : Form
    {
        private readonly Panel sidebar;
        private readonly Panel areaContenido;
        private readonly List<Button> botonesMenu = new();
        private readonly Dictionary<string, Form> formularios = new();
        private Button? botonActivo;

        public Form1()
        {
            InitializeComponent();

            Text = "Agrosoft SENA";
            StartPosition = FormStartPosition.CenterScreen;
            WindowState = FormWindowState.Maximized;
            BackColor = Tema.FondoGeneral;
            DoubleBuffered = true;
            MinimumSize = new Size(1100, 700);
            Resize += Form1_Resize;

            sidebar = CrearSidebar();
            areaContenido = CrearAreaContenido();

            Controls.Add(sidebar);
            Controls.Add(areaContenido);

            var dashboard = new DashboardForm();
            var sensores = CrearVista("Sensores", "Monitoreo del estado de los sensores");
            var conexiones = CrearVista("Conexiones", "Conexiones activas y servicios");
            var perfil = CrearVista("Perfil", "Datos del usuario y configuraciones");

            formularios["Dashboard"] = dashboard;
            formularios["Sensores"] = sensores;
            formularios["Conexiones"] = conexiones;
            formularios["Perfil"] = perfil;

            AbrirFormulario(dashboard);

            if (botonesMenu.Count > 0)
            {
                SeleccionarBoton(botonesMenu[0]);
            }

            AjustarAreaContenido();
        }

        private Panel CrearSidebar()
        {
            var panelSidebar = new Panel
            {
                Dock = DockStyle.Left,
                Width = 240,
                BackColor = Tema.Blanco,
                BorderStyle = BorderStyle.None
            };

            // 1. Panel de Marca (Superior)
            var panelMarca = new Panel
            {
                Dock = DockStyle.Top,
                Height = 90,
                BackColor = Tema.Blanco,
                Padding = new Padding(16, 18, 16, 12)
            };

            var logo = new Label
            {
                Size = new Size(40, 40),
                Text = "A",
                Font = new Font("Segoe UI", 16F, FontStyle.Bold),
                ForeColor = Color.White,
                BackColor = Tema.VerdePrincipal,
                TextAlign = ContentAlignment.MiddleCenter,
                Location = new Point(16, 18)
            };

            var titulo = new Label
            {
                Size = new Size(160, 40),
                Text = "Agrosoft SENA",
                Font = new Font("Segoe UI", 13F, FontStyle.Bold),
                ForeColor = Tema.TextoOscuro,
                AutoSize = false,
                TextAlign = ContentAlignment.MiddleLeft,
                Location = new Point(62, 18)
            };

            panelMarca.Controls.Add(logo);
            panelMarca.Controls.Add(titulo);

            var topNav = new Panel
            {
                Dock = DockStyle.Top,
                Height = 170,
                BackColor = Tema.Blanco,
                Padding = new Padding(12, 10, 12, 0)
            };

            string[] opcionesTop = { "Dashboard", "Sensores", "Conexiones" };

            foreach (var opcion in opcionesTop)
            {
                var boton = new Button
                {
                    Name = opcion,
                    Text = opcion,
                    Height = 45,
                    Width = 216,
                    Dock = DockStyle.Top,
                    FlatStyle = FlatStyle.Flat,
                    Font = new Font("Segoe UI", 11F, FontStyle.Bold),
                    ForeColor = Tema.TextoOscuro,
                    BackColor = Color.Transparent,
                    TextAlign = ContentAlignment.MiddleLeft,
                    Padding = new Padding(18, 0, 0, 0),
                    Margin = new Padding(0, 0, 0, 10),
                    Cursor = Cursors.Hand,
                    Anchor = AnchorStyles.Left | AnchorStyles.Right
                };

                boton.FlatAppearance.BorderSize = 0;
                boton.MouseEnter += (_, _) =>
                {
                    if (boton != botonActivo)
                    {
                        boton.BackColor = Tema.VerdeClaro;
                    }
                };
                boton.MouseLeave += (_, _) =>
                {
                    if (boton != botonActivo)
                    {
                        boton.BackColor = Color.Transparent;
                    }
                };
                boton.Click += (_, _) =>
                {
                    string clave = opcion switch
                    {
                        "Dashboard" => "Dashboard",
                        "Sensores" => "Sensores",
                        "Conexiones" => "Conexiones",
                        _ => opcion
                    };

                    if (formularios.TryGetValue(clave, out var formHijo))
                    {
                        AbrirFormulario(formHijo);
                    }

                    SeleccionarBoton(boton);
                };

                botonesMenu.Add(boton);
                topNav.Controls.Add(boton);
            }

            var bottomNav = new Panel
            {
                Dock = DockStyle.Bottom,
                Height = 120,
                BackColor = Tema.Blanco,
                Padding = new Padding(12, 0, 12, 0)
            };

            var botonPerfil = new Button
            {
                Name = "Editar perfil",
                Text = "Editar perfil",
                Height = 45,
                Width = 216,
                Dock = DockStyle.Top,
                FlatStyle = FlatStyle.Flat,
                Font = new Font("Segoe UI", 11F, FontStyle.Bold),
                ForeColor = Tema.TextoOscuro,
                BackColor = Color.Transparent,
                TextAlign = ContentAlignment.MiddleLeft,
                Padding = new Padding(18, 0, 0, 0),
                Margin = new Padding(0, 0, 0, 10),
                Cursor = Cursors.Hand,
                Anchor = AnchorStyles.Left | AnchorStyles.Right
            };
            botonPerfil.FlatAppearance.BorderSize = 0;
            botonPerfil.MouseEnter += (_, _) =>
            {
                if (botonPerfil != botonActivo)
                {
                    botonPerfil.BackColor = Tema.VerdeClaro;
                }
            };
            botonPerfil.MouseLeave += (_, _) =>
            {
                if (botonPerfil != botonActivo)
                {
                    botonPerfil.BackColor = Color.Transparent;
                }
            };
            botonPerfil.Click += (_, _) =>
            {
                if (formularios.TryGetValue("Perfil", out var formHijo))
                {
                    AbrirFormulario(formHijo);
                }

                SeleccionarBoton(botonPerfil);
            };
            botonesMenu.Add(botonPerfil);

            var separador = new Panel
            {
                Dock = DockStyle.Top,
                Height = 1,
                Margin = new Padding(0, 10, 0, 8),
                BackColor = Tema.Separador
            };

            var botonCerrar = new Button
            {
                Dock = DockStyle.Bottom,
                Height = 52,
                Text = "Cerrar sesión",
                FlatStyle = FlatStyle.Flat,
                Font = new Font("Segoe UI", 11F, FontStyle.Bold),
                ForeColor = Tema.Rojo,
                BackColor = Color.Transparent,
                TextAlign = ContentAlignment.MiddleCenter,
                Margin = new Padding(0, 0, 0, 0),
                Cursor = Cursors.Hand
            };
            botonCerrar.FlatAppearance.BorderSize = 0;
            botonCerrar.Click += (_, _) =>
            {
                var loginForm = new LoginForm();
                loginForm.Show();
                Hide();
            };

            bottomNav.Controls.Add(botonCerrar);
            bottomNav.Controls.Add(separador);
            bottomNav.Controls.Add(botonPerfil);

            panelSidebar.Controls.Add(panelMarca);
            panelSidebar.Controls.Add(topNav);
            panelSidebar.Controls.Add(bottomNav);

            return panelSidebar;
        }

        private Panel CrearAreaContenido()
        {
            var panel = new Panel
            {
                Location = new Point(240, 0),
                Size = new Size(Math.Max(ClientSize.Width - 240, 0), ClientSize.Height),
                Anchor = AnchorStyles.Top | AnchorStyles.Bottom | AnchorStyles.Left | AnchorStyles.Right,
                BackColor = Tema.FondoGeneral,
                BorderStyle = BorderStyle.None
            };

            return panel;
        }

        private Form CrearVista(string titulo, string descripcion)
        {
            var form = new Form
            {
                Text = titulo,
                BackColor = Tema.FondoGeneral,
                FormBorderStyle = FormBorderStyle.None,
                StartPosition = FormStartPosition.Manual,
                TopLevel = false,
                Padding = new Padding(24),
                Dock = DockStyle.Fill,
                Visible = false
            };

            var contenido = new Panel
            {
                Dock = DockStyle.Fill,
                BackColor = Color.White,
                Padding = new Padding(24),
                BorderStyle = BorderStyle.None
            };

            var encabezado = new Label
            {
                Dock = DockStyle.Top,
                Height = 56,
                Text = titulo,
                ForeColor = Tema.TextoOscuro,
                Font = new Font("Segoe UI", 20F, FontStyle.Bold),
                TextAlign = ContentAlignment.MiddleLeft,
                Margin = new Padding(0, 0, 0, 18)
            };

            var subtitulo = new Label
            {
                Dock = DockStyle.Top,
                Text = descripcion,
                ForeColor = Color.FromArgb(95, 110, 101),
                Font = new Font("Segoe UI", 11F, FontStyle.Regular),
                Height = 24,
                Margin = new Padding(0, 0, 0, 18)
            };

            var tarjeta = new Panel
            {
                Dock = DockStyle.Top,
                Height = 170,
                BackColor = Tema.VerdeClaro,
                Padding = new Padding(18),
                Margin = new Padding(0, 0, 0, 18)
            };

            var tituloTarjeta = new Label
            {
                Dock = DockStyle.Top,
                Text = titulo,
                ForeColor = Tema.TextoOscuro,
                Font = new Font("Segoe UI", 16F, FontStyle.Bold),
                Height = 30
            };

            var textoTarjeta = new Label
            {
                Dock = DockStyle.Fill,
                Text = $"Bienvenido a la vista de {titulo}. Aquí se mostrará la información principal relacionada con esta sección.",
                ForeColor = Tema.TextoOscuro,
                Font = new Font("Segoe UI", 11F, FontStyle.Regular),
                AutoSize = false,
                Padding = new Padding(0, 8, 0, 0)
            };

            tarjeta.Controls.Add(textoTarjeta);
            tarjeta.Controls.Add(tituloTarjeta);
            tarjeta.Controls.SetChildIndex(tituloTarjeta, 0);
            tarjeta.Controls.SetChildIndex(textoTarjeta, 1);

            contenido.Controls.Add(tarjeta);
            contenido.Controls.Add(subtitulo);
            contenido.Controls.Add(encabezado);
            form.Controls.Add(contenido);

            return form;
        }

        private void SeleccionarBoton(Button boton)
        {
            foreach (var item in botonesMenu)
            {
                if (item == boton)
                {
                    item.BackColor = Tema.VerdeClaro;
                    item.ForeColor = Tema.TextoOscuro;
                    item.FlatAppearance.BorderSize = 0;
                }
                else
                {
                    item.BackColor = Color.Transparent;
                    item.ForeColor = Tema.TextoOscuro;
                }
            }

            botonActivo = boton;
        }

        public void AbrirFormulario(Form formHijo)
        {
            if (formHijo == null)
            {
                return;
            }

            areaContenido.Controls.Clear();

            formHijo.TopLevel = false;
            formHijo.FormBorderStyle = FormBorderStyle.None;
            formHijo.Dock = DockStyle.Fill;
            formHijo.Show();
            areaContenido.Controls.Add(formHijo);
            areaContenido.BringToFront();
        }

        private void Form1_Resize(object? sender, EventArgs e)
        {
            AjustarAreaContenido();
        }

        private void AjustarAreaContenido()
        {
            areaContenido.Location = new Point(240, 0);
            areaContenido.Size = new Size(Math.Max(ClientSize.Width - 240, 0), ClientSize.Height);
        }
    }
}
